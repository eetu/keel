exports[`'oauth2-proxy' > renders the same quadlet 1`] = `
"[Unit]
Description=Forward-auth gate in front of every SSO route
After=network-online.target boot-complete.target keel-secrets.service kanidm.service
Wants=network-online.target

[Container]
ContainerName=oauth2-proxy
Image=quay.io/oauth2-proxy/oauth2-proxy@sha256:b1b2021fe8f4004573e8d690dec6c7bb29cc44364572cf8510a05bf3a0ae2ded
Network=host
Volume=/etc/oauth2-proxy:/etc/oauth2-proxy:ro,Z
Environment=OAUTH2_PROXY_HTTP_ADDRESS=127.0.0.1:4180
Environment=OAUTH2_PROXY_PROVIDER=oidc
Environment=OAUTH2_PROXY_REVERSE_PROXY=true
Environment=OAUTH2_PROXY_CLIENT_ID=oauth2-proxy
Environment=OAUTH2_PROXY_CUSTOM_TEMPLATES_DIR=/etc/oauth2-proxy/templates
Environment=OAUTH2_PROXY_UPSTREAMS=static://202
Environment=OAUTH2_PROXY_SESSION_STORE_TYPE=cookie
Environment=OAUTH2_PROXY_COOKIE_SECURE=true
Environment=OAUTH2_PROXY_COOKIE_HTTPONLY=true
Environment=OAUTH2_PROXY_COOKIE_SAMESITE=lax
Environment=OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
Environment=OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
Environment=OAUTH2_PROXY_USER_ID_CLAIM=preferred_username
Environment=OAUTH2_PROXY_EMAIL_DOMAINS=*
Environment=OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=false
Environment=OAUTH2_PROXY_SET_XAUTHREQUEST=true
Environment=OAUTH2_PROXY_OIDC_ISSUER_URL=https://idm.example.test/oauth2/openid/oauth2-proxy
Environment=OAUTH2_PROXY_REDIRECT_URL=https://auth.example.test/oauth2/callback
Environment=OAUTH2_PROXY_COOKIE_DOMAINS=.example.test
Environment=OAUTH2_PROXY_WHITELIST_DOMAINS=.example.test
EnvironmentFile=/etc/secrets/oauth2-proxy.env

[Service]
Slice=keel-core.slice
Restart=always
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
"
`;

