exports[`'kanidm' > renders the same quadlet 1`] = `
"[Unit]
Description=Identity provider — the OIDC issuer everything else trusts
After=network-online.target boot-complete.target traefik.service kanidm-cert-sync.service
Wants=network-online.target kanidm-cert-sync.service

[Container]
ContainerName=kanidm
Image=docker.io/kanidm/server@sha256:7c3d7ed868e91f78c24a7fb9c548876563b375a4203021b730d58369b97ad154
Network=keel-internal.network
PublishPort=127.0.0.1:8443:8443
Volume=/var/lib/kanidm:/data:Z
Volume=/etc/kanidm:/etc/kanidm:ro,Z
Environment=KANIDM_BINDADDRESS=0.0.0.0:8443
Environment=KANIDM_DB_PATH=/data/kanidm.db
Environment=KANIDM_TLS_CHAIN=/etc/kanidm/certs/chain.pem
Environment=KANIDM_TLS_KEY=/etc/kanidm/certs/key.pem
Environment=KANIDM_ORIGIN=https://idm.example.test
Environment=KANIDM_DOMAIN=idm.example.test
HealthCmd=CMD /sbin/kanidmd scripting healthcheck
HealthInterval=5s
HealthStartPeriod=10s
Notify=healthy

[Service]
ExecStartPre=/usr/bin/mkdir -p /var/lib/kanidm
Slice=keel-core.slice
Restart=always
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
"
`;

exports[`'kanidm' > renders the same route 1`] = `
"http:
  routers:
    kanidm:
      rule: "Host(\`idm.example.test\`)"
      entryPoints:
        - websecure
      service: kanidm
      middlewares:
        - internal-only
      tls: {}
  services:
    kanidm:
      loadBalancer:
        serversTransport: insecure-loopback
        servers:
          - url: "https://127.0.0.1:8443"
"
`;

