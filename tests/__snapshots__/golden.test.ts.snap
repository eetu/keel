exports[`'traefik' > renders the same middlewares file 1`] = `
"http:
  middlewares:
    internal-only:
      ipAllowList:
        sourceRange:
          - "198.51.100.0/24"
          - "198.18.0.0/15"
          - "2001:db8:e5:1::/64"
    sso-auth:
      forwardAuth:
        address: "http://127.0.0.1:4180/oauth2/auth"
        trustForwardHeader: true
        authResponseHeaders:
          - X-Auth-Request-User
          - X-Auth-Request-Email
        maxResponseBodySize: 65536
  serversTransports:
    insecure-loopback:
      insecureSkipVerify: true
"
`;

