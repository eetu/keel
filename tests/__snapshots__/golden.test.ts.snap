exports[`'pihole' > renders the same quadlet 1`] = `
"[Unit]
Description=Pi-hole: the LAN's resolver
After=network-online.target boot-complete.target
Wants=network-online.target

[Container]
ContainerName=pihole
Image=docker.io/pihole/pihole@sha256:a29ad980775f38a8e7524a206ff9c125bc6fcfd9de8de1fc93d2de0671cc1d34
Network=host
Volume=/var/lib/pihole:/etc/pihole:Z
Environment=FTLCONF_dns_upstreams=127.0.0.1#5335
Environment=FTLCONF_dns_listeningMode=all
Environment=FTLCONF_webserver_port=8080o,[::]:8080o
Environment=FTLCONF_database_maxDBdays=7
Environment=FTLCONF_webserver_api_password=
HealthCmd=dig +norecurse +retry=0 @127.0.0.1 pi.hole
HealthInterval=5s
HealthStartPeriod=10s
Notify=healthy

[Service]
ExecStartPre=/usr/bin/mkdir -p /var/lib/pihole
Slice=keel-core.slice
Restart=always
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
"
`;

exports[`'pihole' > renders the same route 1`] = `
"http:
  routers:
    pihole:
      rule: "Host(\`pihole.example.test\`)"
      entryPoints:
        - websecure
      service: pihole
      middlewares:
        - internal-only
        - oauth2-chain-pihole
      tls: {}
  services:
    pihole:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8080"
  middlewares:
    oauth2-errors-pihole:
      errors:
        status:
          - "401"
        service: oauth2-proxy@file
        query: "/oauth2/sign_in?rd=https%3A%2F%2Fpihole.example.test%2F"
    oauth2-chain-pihole:
      chain:
        middlewares:
          - oauth2-errors-pihole
          - sso-auth
"
`;

