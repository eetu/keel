# EditorConfig — https://editorconfig.org
# Editors read indentation and line width from here; Biome (via @anarkisti/biome-config)
# formats with the same 2 spaces and 100 columns.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Shell rendered into the image and read on a terminal — keep it 4-space.
[*.sh]
indent_size = 4

# Markdown keeps trailing whitespace (two trailing spaces = hard line break).
[*.md]
trim_trailing_whitespace = false
