{
  "name": "keel",
  "version": "0.1.0",
  "description": "Immutable core OS image plus a Pulumi configuration layer for the Raspberry Pi fleet.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "render": "tsx src/cli/render.ts",
    "spec": "tsx src/cli/spec.ts",
    "card-config": "tsx src/cli/card-config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:integration": "tests/integration/run.sh",
    "validate": "yarn typecheck && yarn lint && yarn test",
    "card": "image/card.sh",
    "qemu-test": "image/qemu-test.sh",
    "pulumi": "dotenv -e .env -- pulumi",
    "preview": "node --import tsx scripts/pulumi.ts preview --refresh --parallel 4",
    "preview:fast": "node --import tsx scripts/pulumi.ts preview --parallel 4",
    "deploy": "node --import tsx scripts/pulumi.ts up --refresh --parallel 4",
    "deploy:fast": "node --import tsx scripts/pulumi.ts up --parallel 4",
    "bootstrap": "node --import tsx scripts/bootstrap.ts --parallel 4",
    "update": "tsx scripts/update.ts"
  },
  "dependencies": {
    "@pulumi/cloudflare": "^6.20.0",
    "@pulumi/netbird": "file:sdks/netbird",
    "@pulumi/pulumi": "^3.150.0",
    "@pulumi/random": "^4.21.1"
  },
  "devDependencies": {
    "@anarkisti/biome-config": "^1.0.0",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "dotenv-cli": "^11.0.0",
    "pulumi": "3.263.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
