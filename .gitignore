# Installation-specific — copy the .example counterpart and fill in values
src/config/installation.ts
src/config/services.local.ts

# The local catalog's golden, which pins the bytes those entries deploy. Both
# halves are the installation's: a committed snapshot of them would publish what
# this house runs, and would fail every clone whose local catalog differs.
tests/golden.local.test.ts
tests/__snapshots__/golden.local.test.ts.snap

# Rendered output — regenerated by `yarn render`, never committed
build/

# Pulumi self-managed state and per-stack config. state/ is a Syncthing folder,
# and its .stignore is tracked so every clone has it before the share is accepted.
state/*
!state/.stignore
Pulumi.*.yaml
!Pulumi.yaml

# age identity — the one key that decrypts every secret in the image
*.agekey
age.key

# Finder's per-directory junk, which a clone has no use for
.DS_Store

# Node
node_modules/
.yarn/*
!.yarn/releases
.pnp.*

*.log
state.pre-nas.bak/
*.sync-conflict-*
.env
